# Confluence / Wikisphere (public Siemens wiki, Kerberos/NTLM SSO)
WIKI_BASE_URL=https://wiki.siemens.com
WIKI_AUTH_STRATEGY=cookie          # cookie | pat
WIKI_JSESSIONID=<paste-fresh-cookie-value-from-browser-devtools>
WIKI_PAT=                          # leave blank until PAT access is granted

# Default Confluence source (see config/sources.yaml for the full multi-source list)
WIKI_DEFAULT_SPACE_KEY=en
WIKI_DEFAULT_ROOT_PAGE_ID=295931756

# DAAI internal Confluence (different instance, EntraID SSO) -- separate
# base URL, separate session cookie, separate target search index
CONFLUENCE_BASE_URL=https://confluence.ct.daai.siemens.cloud
CONFLUENCE_AUTH_STRATEGY=cookie    # cookie | pat
CONFLUENCE_JSESSIONID=<paste-fresh-cookie-value-from-browser-devtools>
CONFLUENCE_PAT=
CONFLUENCE_SEARCH_INDEX=sdc-ops-l1-index

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KEY=<admin-key>
AZURE_SEARCH_INDEX=siemens-wiki-index

# Azure AI Foundry -- embedding model deployment only. If your project also
# hosts a non-OpenAI chat model (e.g. Claude), that's a separate integration
# (azure-ai-inference SDK) for the later chatbot/agent phase, not this.
AI_FOUNDRY_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com
AI_FOUNDRY_KEY=<key>
AI_FOUNDRY_EMBED_DEPLOYMENT=text-embedding-3-small
AI_FOUNDRY_API_VERSION=2024-02-01
AI_FOUNDRY_EMBED_DIMENSIONS=1536

# MCP server
MCP_TRANSPORT=stdio                # stdio | http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Function App deployment knob: empty = sync every instance (local runs).
# When actually deployed as two separate Function Apps, set this app setting
# to "wiki" on one and "confluence" on the other -- same codebase, each
# resource only syncs its own instance.
INGESTION_INSTANCE=
